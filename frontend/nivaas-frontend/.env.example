# NIVAAS frontend — environment configuration
# Copy to .env.local and fill in per environment. Never commit .env.local.

# Base URL of the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Leaflet tile provider — kept configurable so staging/prod can use a
# paid tile provider without a code change
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Show TanStack Query devtools overlay (true/false)
VITE_ENABLE_QUERY_DEVTOOLS=true

# development | staging | production
VITE_APP_ENV=development
